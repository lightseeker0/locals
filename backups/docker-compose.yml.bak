services:
  api:
    build: ./server
    # We don't strictly need to expose ports to the host if using a tunnel
    # but keeping 3000 exposed for local testing is helpful.
    ports:
      - "3000:3000"
    volumes:
      - ./server/data:/app/data
      - ./:/app_root
    environment:
      - NODE_ENV=production
    restart: always

  tunnel:
    image: cloudflare/cloudflared:latest
    command: tunnel --config /etc/cloudflared/config.yml run
    volumes:
      - ./cloudflared:/etc/cloudflared:ro
    restart: always
    depends_on:
      - api
